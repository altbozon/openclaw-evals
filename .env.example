# Copy to .env and fill in. The .env file is gitignored.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o-mini) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=...

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Weights & Biases (for Weave dashboard) — https://wandb.ai/authorize
WANDB_API_KEY=

# LangSmith (for LangSmith dashboard) — https://smith.langchain.com settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openclaw-evals
# Set endpoint to eu.api.smith.langchain.com if your account is on EU region (eu.smith.langchain.com)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
