# Copy to .env and fill in. The .env file is gitignored.

# OpenAI (GPT-4o-mini) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=...

# Groq (Llama-3.3-70b — free tier, ~400ms latency) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter (optional fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Weights & Biases (for Weave dashboard) — https://wandb.ai/authorize
WANDB_API_KEY=

# LangSmith (for LangSmith dashboard) — https://smith.langchain.com settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openclaw-evals
# EU accounts: set endpoint + workspace ID (both required — see README)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=<your-workspace-uuid>
LANGSMITH_TRACING=true
